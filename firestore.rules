rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Reusable Security Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for User Profile
    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && data.keys().hasAll(['userId', 'email'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']);
    }

    // Validation for User Watchlist
    function isValidWatchlist(data, userId) {
      return data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && data.symbols is list && data.symbols.size() <= 200
        && (!('isDefault' in data) || data.isDefault is bool)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && data.keys().hasAll(['id', 'userId', 'name', 'symbols'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'symbols', 'isDefault', 'createdAt', 'updatedAt']);
    }

    // Validation for User Trading Journal Entry
    function isValidTrade(data, userId) {
      return data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 32
        && (data.direction == 'LONG' || data.direction == 'SHORT')
        && data.entryPrice is number && data.entryPrice > 0
        && data.exitPrice is number && data.exitPrice > 0
        && data.quantity is number && data.quantity > 0
        && data.grossPnL is number
        && data.netPnL is number
        && (data.outcome == 'WIN' || data.outcome == 'LOSS' || data.outcome == 'BREAKEVEN')
        && (!('stopLoss' in data) || (data.stopLoss is number && data.stopLoss >= 0))
        && (!('targetPrice' in data) || (data.targetPrice is number && data.targetPrice >= 0))
        && (!('brokerageFees' in data) || (data.brokerageFees is number && data.brokerageFees >= 0))
        && (!('returnPercent' in data) || data.returnPercent is number)
        && (!('riskRewardAchieved' in data) || data.riskRewardAchieved is number)
        && (!('setupCategory' in data) || (data.setupCategory is string && data.setupCategory.size() <= 64))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2048))
        && (!('date' in data) || (data.date is string && data.date.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && data.keys().hasAll(['id', 'userId', 'symbol', 'direction', 'entryPrice', 'exitPrice', 'quantity', 'grossPnL', 'netPnL', 'outcome'])
        && data.keys().hasOnly(['id', 'userId', 'date', 'symbol', 'direction', 'entryPrice', 'exitPrice', 'stopLoss', 'targetPrice', 'quantity', 'brokerageFees', 'setupCategory', 'notes', 'grossPnL', 'netPnL', 'returnPercent', 'riskRewardAchieved', 'outcome', 'createdAt', 'updatedAt']);
    }

    // Validation for Chart Preferences
    function isValidPreferences(data, userId) {
      return data.userId == userId
        && data.id is string && data.id.size() <= 128
        && (!('defaultSymbol' in data) || (data.defaultSymbol is string && data.defaultSymbol.size() <= 32))
        && (!('timeframe' in data) || (data.timeframe is string && data.timeframe.size() <= 16))
        && (!('showOrderBlocks' in data) || data.showOrderBlocks is bool)
        && (!('showLiquidity' in data) || data.showLiquidity is bool)
        && (!('showSMA' in data) || data.showSMA is bool)
        && (!('showVolume' in data) || data.showVolume is bool)
        && (!('candleStyle' in data) || (data.candleStyle is string && data.candleStyle.size() <= 32))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && data.keys().hasAll(['id', 'userId'])
        && data.keys().hasOnly(['id', 'userId', 'defaultSymbol', 'timeframe', 'showOrderBlocks', 'showLiquidity', 'showSMA', 'showVolume', 'candleStyle', 'updatedAt']);
    }

    // User Subcollections - Strictly Partitioned by Authenticated User ID
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if false;

      match /watchlists/{watchlistId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(watchlistId) && isValidWatchlist(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(watchlistId) && isValidWatchlist(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /trades/{tradeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(tradeId) && isValidTrade(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(tradeId) && isValidTrade(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /preferences/{prefId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(prefId) && isValidPreferences(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(prefId) && isValidPreferences(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
