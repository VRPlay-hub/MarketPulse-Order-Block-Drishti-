# MarketPulse India Environment Configuration
# ALL VARIABLES ARE COMPLETELY OPTIONAL.
# When empty or omitted, the application runs out-of-the-box in Demonstration Mode
# using synthetic demonstration data and local state with zero API keys or secrets required.
# NOTE: Server-side only variables. Never prefix with VITE_ or expose to client code.

PORT=3000

# Market Data Provider: 'synthetic' (default) | 'upstox' | 'zerodha'
# Leave unset or set to 'synthetic' for zero-config demonstration mode
MARKET_DATA_PROVIDER=synthetic

# Upstox Developer API v2 Credentials (Free for Upstox Account Holders)
# Register your app at: https://developer.upstox.com/
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=

# Zerodha Kite Connect Credentials (Optional Alternative - ₹500/mo)
# Register your app at: https://developers.kite.trade/
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Cache TTL in seconds (Default: 30 seconds for live quotes, 24 hours for daily EOD)
MARKET_CACHE_TTL_SECONDS=30
